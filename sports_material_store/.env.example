# Generate a strong secret before using beyond demo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-local-secret-key

# Optional: if empty, the chatbot still works in local fallback mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local admin password for /admin/login
ADMIN_PASSWORD=admin123
